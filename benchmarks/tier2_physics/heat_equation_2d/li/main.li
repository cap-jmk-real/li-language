# Li driver for shared heat kernel (common/heat_core.c — same kernel as native).

extern def li_heat_2d_kernel()
  requires true
  ensures true

extern def li_heat_2d_checksum() -> float
  requires true
  ensures true

extern def li_rt_volatile_sink_f64(v: float) -> unit
  requires true
  ensures true

def main() raises IO -> int
  requires true
  ensures result == 0
  decreases 0
=
  li_heat_2d_kernel()
  li_rt_volatile_sink_f64(li_heat_2d_checksum())
  return 0